{
  "rewrites": [
    { "source": "/p/:listingId", "destination": "/api/p?listingId=:listingId" },
    { "source": "/b/:code", "destination": "/api/share?kind=b&id=:code" },
    { "source": "/c/:token", "destination": "/api/share?kind=c&id=:token" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
