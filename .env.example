# Copy to fe/.env.local (or fe/.env) and fill in values.
# Vite only loads env files from this fe/ directory.

# ── Required: Firebase (Firestore/Storage data only — auth is Supabase, see below) ──
# Firebase Console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Admin access (comma-separated bootstrap emails — always allowed even before Supabase table)
# Also run fe/supabase/admin_schema.sql and add rows to admin_allowlist for team members.
VITE_ADMIN_EMAILS=

# ── Supabase (browser — anon/publishable key only) ───────────────────────────
# Dashboard → Settings → API Keys → Project URL + anon or publishable key
# Run fe/supabase/broker_schema.sql once (SQL editor) to create the broker
# CRM tables (hunters/properties/follow_ups/tasks/visit_schedules/property_matches).
# Run fe/supabase/admin_schema.sql for the admin email allowlist table.
# Run fe/supabase/chatbot_schema.sql for chatbot session/message history.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
# Or use new publishable key instead of anon (when legacy keys are disabled):
# VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Flat search agent (local Python API) ─────────────────────────────────────
# Start with: cd be/agent && ./run_local.sh
VITE_FLAT_AGENT_API_URL=http://127.0.0.1:8080

# ── EmailJS (browser transactional mail) ─────────────────────────────────────
# Dashboard → Account → API Keys / Email Services / Email Templates
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
# Optional separate templates (fall back to VITE_EMAILJS_TEMPLATE_ID):
# VITE_EMAILJS_INTEREST_TEMPLATE_ID=
# VITE_EMAILJS_STATUS_TEMPLATE_ID=

# ── Payments ─────────────────────────────────────────────────────────────────
# Razorpay Payment Page (rzp.io) — has a built-in default if unset
VITE_RAZORPAY_PAYMENT_LINK=
# VITE_RAZORPAY_PAYMENT_LINK_FLAT=
# VITE_RAZORPAY_PAYMENT_LINK_DEPOSIT=
# VITE_RAZORPAY_PAYMENT_LINK_MATCH=
VITE_BILLING_CONTACT_EMAIL=
# Optional UPI fallback on /checkout (Razorpay link still works without these)
# VITE_BUSINESS_UPI_VPA=
# VITE_CHECKOUT_UPI_QR_IMAGE_URL=
# VITE_WHATSAPP_ORDER_E164=

# ── Optional ─────────────────────────────────────────────────────────────────
# Cloud Functions (skip EmailJS when set)
# VITE_ONBOARDING_EMAIL_FUNCTION_URL=
# VITE_CREATE_PROFILE_FUNCTION_URL=
# In-page Razorpay modal (requires Cloud Function)
# VITE_RAZORPAY_ORDER_URL=
# Error reporting
# VITE_SENTRY_DSN=
# Firebase App Check (local: set debug token, register in Console)
# VITE_APPCHECK_RECAPTCHA_SITE_KEY=
# VITE_APPCHECK_DEBUG_TOKEN=
# Dev-only: seed static listings into Firestore
# VITE_ENABLE_SEED_LISTINGS=

# E2E tests only (not read by Vite)
# PLAYWRIGHT_BASE_URL=
# MOVEASY_ADMIN_EMAIL=
# MOVEASY_ADMIN_PASSWORD=
